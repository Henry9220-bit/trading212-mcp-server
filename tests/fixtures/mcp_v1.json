    {
      "name": "fetch_open_lots",
      "description": "\n        Rebuild the individual buys (lots) still held, using FIFO.\n\n        Reads historical orders page by page, replays FILLED trade fills oldest\n        first, matches sells against the oldest lots, and reconciles the result\n        with the open positions. Read-only: it only issues GET requests.\n\n        Each lot reports when it was bought, shares remaining, price in the\n        instrument currency (GBX is pence) and cost in the account currency.\n        Each ticker summary has ``reconciled``; when false, the lots are still\n        returned unchanged and ``notes`` explains likely causes, such as a\n        stock split, a transferred-in position, or truncated history.\n\n        Pages are spaced to the documented rate limit (20 requests per\n        minute), so a long uncached history can take minutes: roughly three\n        seconds per page after the first.\n\n        Args:\n            ticker: Limit to one instrument (e.g. 'AAPL_US_EQ'). Omit for all.\n            max_pages: Maximum history pages of 50 orders to read, clamped to\n                1-200. If more history exists, ``truncated`` is true.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ticker"
          },
          "max_pages": {
            "default": 40,
            "title": "Max Pages",
            "type": "integer"
          }
        },
        "title": "fetch_open_lotsArguments"
      }
    }
  ],
